# Model options (litellm supports: gemini/gemini-2.0-flash, gpt-4o, claude-3-5-sonnet, etc.)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (if you want to test multi-model)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: GitHub token to increase rate limit from 60 to 5,000 req/hr
# GITHUB_TOKEN=your_github_token_here